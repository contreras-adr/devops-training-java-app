/* 
  Practica 2 - ejercicio 2
*/
 
pipeline {  
  agent any

  stages {
    stage('Info') {
      steps {
        sh 'echo "Job: $JOB_NAME"'
        sh 'echo "build: $BUILD_NUMBER"'
      }      
    }
    stage('Test') {      
      agent {
        docker {
          image 'maven:3.8.6-openjdk-11-slim'
          args '-u root:root' // opcional: evita problemas de permisos
        }
      }
      steps {
        sh 'mvn -version'
        sh 'mvn test'
      }
    }
  }
}
